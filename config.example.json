{
  "accounts": [
    { "name": "P", "envPrefix": "TU_A" },
    { "name": "Yoh", "envPrefix": "TU_B" }
  ],
  "schedule": [
    {
      "days": ["mon", "tue", "wed", "thu", "fri"],
      "slots": [{ "time": "18:00-20:00", "courts": [2, 4, "any"] }]
    },
    {
      "days": ["sat", "sun"],
      "slots": [{ "time": "18:00-20:00", "courts": [2, 1, "any"] }]
    }
  ],
  "advanceDaysCandidates": [5, 6],
  "randomizeAccounts": true,
  "race": {
    "fireAt": "07:00:00",
    "deadline": "07:05:00",
    "accountIntervalMs": 2000,
    "ipIntervalMs": 1000,
    "rateLimitBackoffMs": 5000,
    "gatePollIntervalMs": 2000,
    "requestTimeoutMs": 8000,
    "authAttempts": 3,
    "authRetryDelayMs": 300,
    "humanize": {
      "enabled": false,
      "jitterMs": 400,
      "initialJitterMs": 500,
      "warmupMs": 30000
    }
  },
  "notify": { "telegram": true }
}
